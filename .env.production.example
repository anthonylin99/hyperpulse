# HyperPulse self-hosted production env.
# Copy to `.env` on the droplet and fill in real values:  cp .env.production.example .env
# Compose reads `.env` automatically. Never commit the real `.env`.

# ----- Domain / TLS (Caddy) -----
# The public hostname. Caddy auto-issues a Let's Encrypt cert for it.
DOMAIN=hyperpulsehl.com

# ----- Web (client-facing) -----
# Public base URL, used by the app and baked into the client bundle at build.
NEXT_PUBLIC_APP_URL=https://hyperpulsehl.com
# Bind the web container's port to localhost only. Docker port publishing
# bypasses ufw, so do NOT use a bare "3000". Caddy reaches it as web:3000.
WEB_PORT=127.0.0.1:3000
# Privy app id for wallet connect (from privy.io dashboard). Leave blank to run
# fully read-only without wallet connect. Baked in at build time.
NEXT_PUBLIC_PRIVY_APP_ID=

# ----- Feature flags (keep trading off for a public read-only deploy) -----
ENABLE_TRADING=false
ENABLE_FACTORS=false
ENABLE_VAULTS=false
NEXT_PUBLIC_ENABLE_TRADING=false
NEXT_PUBLIC_ENABLE_FACTORS=false
NEXT_PUBLIC_ENABLE_VAULTS=false
NEXT_PUBLIC_ENABLE_SAVED_WALLETS=true

# ----- Database (self-hosted Postgres container) -----
# Turn the warehouse ON (the app is shipped frozen by default).
HYPERPULSE_DB_ENABLED=true
POSTGRES_USER=hyperpulse
POSTGRES_DB=hyperpulse
# Strong random password. Generate: openssl rand -hex 24
# (hex only — base64 can emit "/" and "+", which break the DATABASE_URL
# below unless percent-encoded)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Internal connection string — host is the compose service name "postgres".
# No sslmode param on purpose: the DB is on the private compose network, so the
# app connects without TLS (adding sslmode=require would force verify-full and fail).
# Keep the password here in sync with POSTGRES_PASSWORD above.
DATABASE_URL=postgres://hyperpulse:CHANGE_ME_STRONG_PASSWORD@postgres:5432/hyperpulse

# ----- Network -----
HYPERPULSE_NETWORK=mainnet

# ----- Telegram alerts (optional; momentum-alerts worker) -----
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----- Worker tuning (optional; sane defaults live in docker-compose.yml) -----
# MARKET_COLLECTOR_ASSET_LIMIT=15
# MOMENTUM_ALERT_INTERVAL_MS=300000
# REACTION_MAP_ASSETS=all
